---
import Logo from './Logo.astro';
import { club } from '../data/club';
import { withBase } from '../lib/url';
---

<div class="checker-band"></div>
<footer class="site-footer">
  <div class="wrap site-footer__top">
    <div class="site-footer__brand">
      <div class="brand">
        <Logo size={32} inverse />
        <span class="brand__name">Swale Chess Club</span>
      </div>
      <p>
        {club.venue.name}, {club.venue.building},<br />
        {club.venue.street}, {club.venue.town},<br />
        {club.venue.county} {club.venue.postcode}
      </p>
      <p>Thursdays from {club.meets.time}</p>
    </div>

    <nav class="site-footer__col" aria-label="Club pages">
      <p class="site-footer__heading">The club</p>
      <a href={withBase('/news/')}>Club reports</a>
      <a href={withBase('/juniors/')}>Junior chess</a>
      <a href={withBase('/puzzles/')}>Puzzles</a>
      <a href={withBase('/tournaments/')}>Tournaments</a>
      <a href={withBase('/join/')}>Join us</a>
      <a href={`mailto:${club.contact.email}`}>Contact</a>
    </nav>

    <nav class="site-footer__col" aria-label="Chess elsewhere">
      <p class="site-footer__heading">Chess elsewhere</p>
      <a href="https://lms.englishchess.org.uk/lms/" rel="noopener">ECF League Management System</a>
      <a href="https://kentchess.org/" rel="noopener">Kent County Chess Association</a>
      <a href="https://www.englishchess.org.uk/" rel="noopener">English Chess Federation</a>
      <a href={club.contact.facebook} rel="noopener">Facebook group</a>
    </nav>
  </div>

  <div class="site-footer__bar">
    <div class="wrap site-footer__bar-inner">
      <p>&copy; {new Date().getFullYear()} Swale Chess Club</p>
      <p>Affiliated to the Kent County Chess Association</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--c-green-deep);
    margin-top: auto;
  }

  .site-footer__top {
    display: grid;
    gap: 3.5rem;
    padding-block: 3.5rem 2.75rem;
  }

  @media (min-width: 860px) {
    .site-footer__top {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  .site-footer__brand {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .brand__name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--c-on-green);
  }

  .site-footer__brand p {
    font-size: 0.9375rem;
    color: var(--c-on-green-faint);
    line-height: 1.6;
  }

  .site-footer__col {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .site-footer__heading {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-brass-light);
  }

  .site-footer__col a {
    font-size: 1rem;
    color: #dce6de;
  }

  .site-footer__col a:hover { color: var(--c-brass-light); }

  .site-footer__bar { border-top: 1px solid var(--c-green-line); }

  .site-footer__bar-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1.375rem;
  }

  .site-footer__bar p {
    font-size: 0.875rem;
    color: #7e9686;
  }
</style>
