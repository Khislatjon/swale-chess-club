---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { nav, navCta } from '../data/club';
import { withBase } from '../lib/url';

const path = Astro.url.pathname;
const isCurrent = (href: string) => {
  const target = withBase(href);
  return href === '/' ? path === target : path.startsWith(target);
};
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a href={withBase('/')} class="brand">
      <Logo />
      <span class="brand__name">Swale Chess Club</span>
    </a>

    <input type="checkbox" id="nav-toggle" class="visually-hidden nav-toggle" />
    <label for="nav-toggle" class="nav-button">
      <Icon name="menu" size={22} />
      <span class="visually-hidden">Menu</span>
    </label>

    <nav class="site-nav" aria-label="Main">
      {
        nav.map((item) => (
          <a
            href={withBase(item.href)}
            class:list={['site-nav__link', { 'is-current': isCurrent(item.href) }]}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <a
        href={withBase(navCta.href)}
        class="btn btn--primary site-nav__cta"
        aria-current={isCurrent(navCta.href) ? 'page' : undefined}
      >
        {navCta.label}
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: var(--c-bg);
    border-bottom: 1px solid var(--c-border);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2.5rem;
    padding-block: 1.25rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.8125rem;
  }

  .brand__name {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 600;
    letter-spacing: -0.012em;
    color: var(--c-green-deep);
    white-space: nowrap;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 0.125rem;
  }

  .site-nav__link {
    padding: 0.75rem 0.9375rem;
    font-size: 1rem;
    font-weight: 500;
    color: var(--c-ink-soft);
    border-radius: 8px;
  }

  .site-nav__link.is-current {
    color: var(--c-green-deep);
    background: #ede7d8;
  }

  .site-nav__cta {
    margin-left: 0.75rem;
    min-height: 46px;
    padding-inline: 1.375rem;
    font-size: 1rem;
    border-radius: 9px;
  }

  .nav-button {
    display: none;
    width: 46px;
    height: 46px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--c-border);
    background: var(--c-surface-warm);
    border-radius: var(--radius);
    color: var(--c-green-deep);
    cursor: pointer;
  }

  /* Checkbox-driven disclosure keeps the menu working without JavaScript. */
  @media (max-width: 900px) {
    .site-header__inner {
      flex-wrap: wrap;
      gap: 1rem;
    }

    .nav-button {
      display: flex;
    }

    .site-nav {
      display: none;
      width: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 0.25rem;
      padding-bottom: 0.75rem;
    }

    .nav-toggle:checked ~ .site-nav {
      display: flex;
    }

    .site-nav__link {
      padding: 0.875rem 0.75rem;
      font-size: 1.0625rem;
      border-bottom: 1px solid var(--c-border);
      border-radius: 0;
    }

    .site-nav__cta {
      margin-left: 0;
      margin-top: 0.75rem;
    }
  }
</style>
