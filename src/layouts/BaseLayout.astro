---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { club, fullAddress } from '../data/club';
import { withBase } from '../lib/url';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const pageTitle = title === club.name ? title : `${title} — ${club.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// The GitHub Pages build is a preview copy of the site, not the canonical
// home for this content — keep it out of search results so it never
// competes with the club's own domain.
const isPreviewHost = Astro.site?.hostname.endsWith('github.io') ?? false;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    {isPreviewHost && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={club.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&display=swap"
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'SportsClub',
        name: club.name,
        description: club.tagline,
        url: String(Astro.site),
        email: club.contact.email,
        telephone: club.contact.phone,
        sameAs: [club.contact.facebook],
        address: {
          '@type': 'PostalAddress',
          streetAddress: `${club.venue.name}, ${club.venue.building}, ${club.venue.street}`,
          addressLocality: club.venue.town,
          addressRegion: club.venue.county,
          postalCode: club.venue.postcode,
          addressCountry: 'GB',
        },
        openingHours: 'Th 19:40',
      })}
    />
  </head>

  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <span class="visually-hidden">{fullAddress}</span>
  </body>
</html>
