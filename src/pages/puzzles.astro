---
import BaseLayout from '../layouts/BaseLayout.astro';
import { puzzles } from '../data/puzzles';
import { withBase } from '../lib/url';
---

<BaseLayout
  title="Puzzles"
  description="Mini-puzzles from real games at Swale Chess Club, contributed by members. Find the move, then reveal the answer."
>
  <section class="section section--warm">
    <div class="wrap page-head">
      <p class="eyebrow">Puzzles</p>
      <h1>Mini-puzzles</h1>
      <p class="lede">
        Positions from real games at the club and at congresses our members play
        in, written up for the weekly report. Work out the move first — the
        answer is hidden until you reveal it.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap puzzle-list">
      {
        puzzles.map((puzzle) => (
          <article class="card puzzle" id={puzzle.id}>
            <div class="puzzle__board">
              <img
                src={withBase(puzzle.image)}
                width="370"
                height="370"
                loading="lazy"
                alt={`Chess position — ${puzzle.toMove ?? 'see the question'}`}
              />
            </div>

            <div class="puzzle__text">
              <div class="meta-row">
                {puzzle.contributor && (
                  <span class="tag">Contributed by {puzzle.contributor}</span>
                )}
                <span>Posted {puzzle.posted}</span>
              </div>

              {puzzle.intro.map((par) => (
                <p class="puzzle__intro" set:html={par} />
              ))}

              {puzzle.toMove && <p class="puzzle__tomove" set:html={puzzle.toMove} />}

              <details class="answer">
                <summary>Mini-answer</summary>
                <div class="answer__body">
                  {puzzle.answerImage && (
                    <img
                      src={withBase(puzzle.answerImage)}
                      width="370"
                      height="370"
                      loading="lazy"
                      alt="Chess position after the answer's moves"
                    />
                  )}
                  {puzzle.answer.map((par) => (
                    <p set:html={par} />
                  ))}

                  {puzzle.followUp && (
                    <div class="answer__followup">
                      {puzzle.followUp.intro.map((par) => (
                        <p set:html={par} />
                      ))}
                      <img
                        src={withBase(puzzle.followUp.image)}
                        width="370"
                        height="370"
                        loading="lazy"
                        alt="Chess position for part (b)"
                      />
                      <details class="answer">
                        <summary>Mini-answer</summary>
                        <div class="answer__body">
                          {puzzle.followUp.answer.map((par) => (
                            <p set:html={par} />
                          ))}
                        </div>
                      </details>
                    </div>
                  )}
                </div>
              </details>
            </div>
          </article>
        ))
      }

      <p class="small muted puzzle-credit">
        Puzzles are taken from games by club members and written up in the weekly
        club report. Got one of your own? Send it to the club and it may feature
        here.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .page-head {
    display: flex;
    flex-direction: column;
    gap: 1.125rem;
  }

  .puzzle-list {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .puzzle {
    display: grid;
    gap: 1.75rem;
    padding: 2rem;
  }

  @media (min-width: 900px) {
    .puzzle {
      grid-template-columns: 370px minmax(0, 1fr);
      gap: 2.5rem;
      align-items: start;
    }
  }

  .puzzle__board img,
  .answer__body img {
    border: 1px solid var(--c-border);
    border-radius: 8px;
    background: var(--c-surface);
  }

  .puzzle__text {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .puzzle__intro {
    color: var(--c-ink-soft);
  }

  .puzzle__intro :global(a) {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .puzzle__tomove {
    font-weight: 600;
    color: var(--c-green-deep);
  }

  .answer {
    margin-top: 0.375rem;
  }

  .answer summary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0.5rem 1.375rem;
    border: 1px solid var(--c-border-strong);
    border-radius: var(--radius);
    background: var(--c-surface-warm);
    font-weight: 600;
    color: var(--c-green);
    cursor: pointer;
    user-select: none;
    list-style: none;
  }

  .answer summary::-webkit-details-marker {
    display: none;
  }

  .answer summary::before {
    content: '';
    width: 0;
    height: 0;
    border-left: 6px solid currentColor;
    border-top: 5px solid transparent;
    border-bottom: 5px solid transparent;
    transition: transform 0.15s ease;
  }

  .answer[open] > summary::before {
    transform: rotate(90deg);
  }

  .answer summary:hover {
    border-color: var(--c-green);
  }

  .answer__body {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    margin-top: 1rem;
    padding: 1.375rem 1.5rem;
    border: 1px solid var(--c-border);
    border-left: 4px solid var(--c-brass);
    border-radius: 12px;
    background: var(--c-surface-warm);
  }

  .answer__body p {
    color: var(--c-ink-soft);
  }

  .answer__body :global(b) {
    color: var(--c-green-deep);
  }

  .answer__followup {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    border-top: 1px solid var(--c-border);
    padding-top: 1rem;
  }

  .puzzle-credit {
    border-top: 1px solid var(--c-border);
    padding-top: 1.75rem;
  }
</style>
